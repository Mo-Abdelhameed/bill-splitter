#!/usr/bin/env python3
"""
hook-router — single PostToolUse dispatcher for the spec-driven workflow.

Reads a Claude Code hook event from stdin, inspects the changed file, and
dispatches to one of:

  - story edit (specs/features/**/*.md):
      1. regen-index
      2. if Status is pending-verification: run `flutter test` (full suite);
         on pass, emit a message asking the main agent to invoke `verifier`
         (and `ui-verifier` if visual AC are present);
         on fail, revert Status to in-progress and append a Verification note.

  - source edit (lib/**/*.dart):
      run the matching test/**/*_test.dart if it exists. Silent if not.

  - test edit (test/**/*_test.dart):
      run that single test file.

  - anything else: no-op.

The hook never blocks edits. All subprocess failures are logged to stderr
and result in exit 0.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path


TEST_TIMEOUT_SECONDS = 180


def log(message: str) -> None:
    print(f"[spec-hook] {message}", file=sys.stderr)


def run(cmd: list[str], cwd: Path, capture: bool = False, timeout: int | None = None):
    """Run a subprocess, swallow errors, optionally capture output."""
    try:
        return subprocess.run(
            cmd,
            cwd=cwd,
            capture_output=capture,
            text=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        log(f"command not found: {cmd[0]}")
    except subprocess.TimeoutExpired:
        log(f"timed out after {timeout}s: {' '.join(cmd)}")
    except Exception as exc:
        log(f"subprocess error: {exc}")
    return None


def regen_index(project_dir: Path) -> None:
    run(
        ["python3", str(project_dir / "scripts" / "spec" / "regen-index")],
        cwd=project_dir,
    )


def handle_story_edit(story_path: Path, project_dir: Path) -> None:
    regen_index(project_dir)

    try:
        text = story_path.read_text(encoding="utf-8")
    except OSError as exc:
        log(f"cannot read {story_path}: {exc}")
        return

    status_match = re.search(r"^Status:\s*(\S+)", text, re.MULTILINE)
    if not status_match:
        return

    status = status_match.group(1).strip()
    if status != "pending-verification":
        return

    story_id_match = re.search(r"STORY-(\d+)", story_path.name)
    story_id = f"STORY-{story_id_match.group(1)}" if story_id_match else "(unknown)"

    log(f"{story_id} is pending-verification; running full Flutter test suite...")
    result = run(
        ["flutter", "test"],
        cwd=project_dir,
        capture=True,
        timeout=TEST_TIMEOUT_SECONDS,
    )

    if result is None:
        log("flutter test could not be run; leaving story untouched.")
        return

    if result.returncode != 0:
        revert_status_to_in_progress(story_path, result.stdout or "", result.stderr or "")
        regen_index(project_dir)
        print(
            f"[spec-hook] {story_id}: `flutter test` failed at transition to "
            f"pending-verification. Status auto-reverted to in-progress; see "
            f"Verification notes in {story_path}.",
        )
        return

    # Full suite passed. Detect visual AC for ui-verifier trigger.
    has_visual_ac = bool(re.search(r"\[visual\b", text))
    visual_note = " and `ui-verifier`" if has_visual_ac else ""

    print(
        f"[spec-hook] {story_id} reached pending-verification and the full Flutter "
        f"test suite passed. Invoke the `verifier` sub-agent{visual_note} now to judge "
        f"acceptance criteria against the current code. Do NOT mark the story `done` "
        f"yourself — only the verifier can."
    )


def revert_status_to_in_progress(story_path: Path, stdout: str, stderr: str) -> None:
    """Rewrite the story's Status line back to in-progress and append a note."""
    try:
        text = story_path.read_text(encoding="utf-8")
    except OSError as exc:
        log(f"cannot reread {story_path}: {exc}")
        return

    new_text = re.sub(
        r"^(Status:\s*).*$",
        r"\1in-progress",
        text,
        count=1,
        flags=re.MULTILINE,
    )

    combined = (stdout + "\n" + stderr).strip()
    tail = "\n".join(combined.splitlines()[-40:])

    note_block = (
        "## Verification notes\n\n"
        "Auto-reverted to `in-progress`: full `flutter test` suite failed at the "
        "attempted transition to `pending-verification`. Fix the failing tests, "
        "re-run the suite locally, and only then re-set Status to "
        "`pending-verification`.\n\n"
        "Last lines of the failing run:\n\n"
        f"```\n{tail}\n```\n"
    )

    if re.search(r"^##\s*Verification notes", new_text, re.MULTILINE):
        new_text = re.sub(
            r"##\s*Verification notes.*\Z",
            note_block,
            new_text,
            flags=re.DOTALL,
        )
    else:
        new_text = new_text.rstrip() + "\n\n" + note_block

    try:
        story_path.write_text(new_text, encoding="utf-8")
    except OSError as exc:
        log(f"cannot write {story_path}: {exc}")


def handle_source_edit(source_rel: Path, project_dir: Path) -> None:
    """For lib/foo/bar.dart, run test/foo/bar_test.dart if it exists."""
    parts = source_rel.parts
    if len(parts) < 2 or parts[0] != "lib":
        return

    test_rel = Path("test", *parts[1:]).with_name(source_rel.stem + "_test.dart")
    test_full = project_dir / test_rel
    if not test_full.exists():
        return

    log(f"running {test_rel} for change to {source_rel}")
    run(
        ["flutter", "test", str(test_rel)],
        cwd=project_dir,
        timeout=TEST_TIMEOUT_SECONDS,
    )


def handle_test_edit(test_rel: Path, project_dir: Path) -> None:
    log(f"running {test_rel}")
    run(
        ["flutter", "test", str(test_rel)],
        cwd=project_dir,
        timeout=TEST_TIMEOUT_SECONDS,
    )


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    tool_name = payload.get("tool_name", "")
    if tool_name not in ("Edit", "Write", "MultiEdit"):
        return 0

    tool_input = payload.get("tool_input", {}) or {}
    file_path = (
        tool_input.get("file_path")
        or tool_input.get("notebook_path")
        or ""
    )
    if not file_path:
        return 0

    project_dir = Path(os.environ.get("CLAUDE_PROJECT_DIR", os.getcwd())).resolve()
    try:
        absolute = Path(file_path).resolve()
        rel = absolute.relative_to(project_dir)
    except (ValueError, OSError):
        return 0

    rel_str = str(rel)
    rel_path = Path(rel_str)

    if rel_str.startswith("specs/features/") and rel_str.endswith(".md"):
        handle_story_edit(project_dir / rel_path, project_dir)
        return 0

    if rel_str.startswith("test/") and rel_str.endswith("_test.dart"):
        handle_test_edit(rel_path, project_dir)
        return 0

    if rel_str.startswith("lib/") and rel_str.endswith(".dart"):
        handle_source_edit(rel_path, project_dir)
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
