# Backend environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file is committed.

# Gemini API key — gets the actual receipt-extraction call.
GEMINI_API_KEY=

# Firebase project ID — used by firebase-admin to verify ID tokens from the app.
FIREBASE_PROJECT_ID=

# Absolute path to the Firebase service-account JSON downloaded from
# console.firebase.google.com (Project Settings > Service Accounts).
# In local dev this is typically `./firebase-admin.json` (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-admin.json
