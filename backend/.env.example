# Gemini API key (server-side only — NEVER ship in the Flutter build)
GEMINI_API_KEY=

# Firebase project id (used by firebase-admin to verify ID tokens)
FIREBASE_PROJECT_ID=bill-splitter

# Path to the Firebase Admin SDK service account JSON.
# In Cloud Run prod, omit this and rely on the runtime service account.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-admin.json
